# Supabase Integration Credentials Placeholder
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI Platform & Third-Party Integrations Requirements
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Cloud SQL PostgreSQL Database Credentials
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ---- Advertising (all values below are PUBLIC ids, never secrets) ----
# Google AdSense Integration Settings.
# The adsbygoogle.js loader itself is hardcoded once in index.html; these
# VITE_ vars are build-time FALLBACKS - the live source of truth is the
# site_settings row in Supabase (editable in the admin portal):
#   adsense_active, adsense_client_id, adsense_slot_<header|sidebar|
#   in_article|footer|homepage|article_bottom>
VITE_ADSENSE_PUBLISHER_ID=
VITE_SLOT_HERO=
VITE_SLOT_CONTENT=
VITE_SLOT_INLINE=
VITE_SLOT_SIDEBAR=
VITE_SLOT_FOOTER=

# Monetag + Adsterra have NO env vars by design: they are configured per
# environment in the Supabase site_settings singleton via the admin portal
# (monetag_active, monetag_zone_id, monetag_loader_url, monetag_sw_domain,
# monetag_sw_zone_id; adsterra_active, adsterra_key_<slot>, adsterra_url_<slot>,
# adsterra_popunder_url / _social_bar_ / _interstitial_ / _inpage_push_script).

# Google Analytics 4 (public measurement id, G-XXXX) - injected only after
# the visitor grants analytics consent.
VITE_GA_MEASUREMENT_ID=

# Meta Pixel (public pixel id) - injected only after marketing consent.
VITE_META_PIXEL_ID=

# Resend Integration Settings
RESEND_API_KEY=

# Payment Gateways (subscriptions & digital products)
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

